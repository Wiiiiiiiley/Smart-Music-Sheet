# Development normally uses Vite's proxy to localhost:3001.
# For a separately hosted Express server:
# VITE_API_URL=https://your-node-backend.example.com
# VITE_WS_URL=https://your-node-backend.example.com
# VITE_REALTIME_TRANSPORT=socketio
# Optional STUN/TURN configuration; values are exposed to browser clients.
# Use service-issued temporary TURN credentials, never a server admin secret.
# VITE_ICE_SERVERS='[{"urls":"stun:your-stun.example.com:3478"},{"urls":"turns:your-turn.example.com:5349","username":"temporary-user","credential":"temporary-credential"}]'
